<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
/* Sin dependencias y en linea a proposito: esto es lo primero que ve alguien que
   ha abierto un correo en frio, muchas veces dentro del navegador de Gmail y con
   la red del movil. Un fichero mas es una espera mas. */
(function () {
  "use strict";
  if (!navigator.webdriver) { document.documentElement.className += " js"; }

  var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* entradas */
  var io = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
    });
  }, { rootMargin: "0px 0px -8% 0px", threshold: .08 });
  document.querySelectorAll(".rise").forEach(function (el) { io.observe(el); });

  /* ── el recorrido de cada obra ────────────────────────────────────────────
     UNA sola tarjeta reproduce a la vez y nada se descarga hasta que su tarjeta
     esta en pantalla: tres decodificadores en paralelo en un movil de gama media
     es lo que convierte una pagina bonita en una pagina que va a tirones.
     ⛔ Con `Save-Data` activo no se pide ni un byte de video. Quien lo enciende
     esta pagando los megas, y las planchas ya cuentan la historia. */
  var saveData = navigator.connection && navigator.connection.saveData;
  var hoverable = matchMedia("(hover: hover)").matches;
  var piezas = [];

  document.querySelectorAll(".piece[data-loop]").forEach(function (card) {
    var v = card.querySelector("video");
    if (!v || reduced || saveData) { return; }
    var armed = false;
    var p = { card: card, ratio: 0 };

    v.addEventListener("playing", function () { card.classList.add("playing"); });

    p.play = function () {
      if (!armed) {              /* el fetch empieza AQUI y en ningun otro sitio */
        armed = true;
        v.src = card.getAttribute("data-loop");
        v.load();
      }
      var pr = v.play();
      if (pr && pr.catch) { pr.catch(function () { /* se queda la plancha */ }); }
    };
    p.stop = function () {
      card.classList.remove("playing");
      if (armed) { v.pause(); }
    };
    piezas.push(p);
  });

  /* UNA sola tarjeta suena, y el resto ni existe. `poner` es el unico sitio
     donde se arranca o se para nada: teniendo dos caminos (raton y scroll) que
     podian llamar a play/stop por su cuenta, la tarjeta que acababa sonando
     dependia del orden en que llegaran los callbacks. */
  var actual = null;
  function poner(p) {
    if (actual === p) { return; }
    if (actual) { actual.stop(); }
    actual = p;
    if (p) { p.play(); }
  }

  /* ⛔ EN TACTIL SE ELIGE LA MAS CENTRADA, NO "la que entre en pantalla".
     Medido en un iPhone de 390x844: las tres tarjetas miden 244 px de alto, o
     sea que CABEN LAS TRES A LA VEZ. Con un observador por tarjeta que
     arrancaba al entrar, las tres pasaban el umbral en el mismo scroll, las
     tres se descargaban (3,8 MB que nadie pidio, justo el fallo que ya nos
     costo un Android sin poder cargar la pagina) y la que se quedaba sonando
     era la ULTIMA en notificar — no la que el visitante esta mirando.
     Ahora gana la que tiene el centro mas cerca del centro de la ventana, y
     como el fetch vive dentro de `play()`, las otras dos no piden ni un byte. */
  function elegir() {
    var mid = innerHeight / 2, mejor = null, dmin = Infinity;
    piezas.forEach(function (p) {
      if (p.ratio < .55) { return; }
      var r = p.card.getBoundingClientRect();
      var d = Math.abs(r.top + r.height / 2 - mid);
      if (d < dmin) { dmin = d; mejor = p; }
    });
    poner(mejor);
  }

  var iov = new IntersectionObserver(function (es) {
    es.forEach(function (e) {
      var p = piezas.filter(function (q) { return q.card === e.target; })[0];
      if (p) { p.ratio = e.intersectionRatio; }
    });
    if (hoverable) {
      /* red de seguridad: una tarjeta que se va de la pantalla deja de
         decodificar, este el raton donde este */
      if (actual && actual.ratio === 0) { poner(null); }
    } else {
      elegir();
    }
  }, { threshold: [0, .25, .55, .75, 1] });
  piezas.forEach(function (p) { iov.observe(p.card); });

  if (hoverable) {
    piezas.forEach(function (p) {
      p.card.addEventListener("pointerenter", function (e) {
        if (e.pointerType !== "touch") { poner(p); }
      });
      p.card.addEventListener("pointerleave", function (e) {
        if (e.pointerType !== "touch") { poner(null); }
      });
      p.card.addEventListener("focus", function () { poner(p); });
      p.card.addEventListener("blur", function () { poner(null); });
    });
  }

  /* la barra dice "hover to browse" — en un telefono esa instruccion es
     simplemente falsa */
  if (!hoverable) {
    var r = document.querySelector("#work .rail .r");
    if (r) { r.textContent = "Live builds"; }
  }

  /* los navegadores paran el video al volver de otra pestaña o del cache
     atras/adelante, y no lo reanuda nadie */
  var resume = function () {
    document.querySelectorAll(".piece.playing video").forEach(function (v) {
      if (v.paused) { var p = v.play(); if (p && p.catch) { p.catch(function () {}); } }
    });
  };
  document.addEventListener("visibilitychange", function () {
    if (!document.hidden) { resume(); }
  });
  window.addEventListener("pageshow", resume);
})();
</script>

<!-- EL CONTADOR DE VISITAS, OTRA VEZ EN PIE (2026-09-06). Este punto invisible es la unica
     medida que existe entre "el correo salio" y "alguien contesto", y llevaba desde el 23-ago
     sin dar un numero: el contador de antes era PHP, vivia en el disco del alojamiento de
     Hostinger y caduco con el el 28-ago.

     Ahora la cuenta la lleva `functions/cnt.js`, que corre en el propio Cloudflare Pages. La
     etiqueta `k=t` es la que separa esta portada —la que enlazan los 1.383 correos de la
     campana— de las demas paginas. Ni IP, ni cookie, ni nada de quien entra: solo se suma uno
     a un numero del dia.

     ESTA LINEA Y `functions/cnt.js` VIAJAN JUNTAS. Si un despliegue se lleva esta linea por
     delante, la pagina vuelve a contar cero en silencio y nadie se entera — ya paso el 12-ago
     y fueron tres dias. Por eso `deploy_ascentatrack.py` se niega a publicar una portada que
     no la lleve.

     CUIDADO AL EDITAR ESTO (2026-09-01): la version anterior de este comentario llevaba OTRO
     comentario metido dentro. Un comentario de HTML se cierra en el PRIMER "-->", asi que los
     1.116 caracteres siguientes se veian como texto en la pagina — en la portada que enlazan
     los 1.278 correos de la campana. Aqui dentro no puede entrar nunca la secuencia de abrir
     comentario. -->
<img src="/cnt?k=t" alt="" width="1" height="1" style="display:none">

</body>
</html>
